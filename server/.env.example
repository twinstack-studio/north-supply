# --- Database -------------------------------------------------------------
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://northsupply:northsupply@localhost:5432/northsupply

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Comma-separated. Put your LAN IP first to test on a phone -- links inside
# emails are built from the first entry.
CLIENT_ORIGIN=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# CHANGE THIS in any real deployment. 32+ random chars.
JWT_SECRET=dev-only-secret-change-me-b8f2c1a94e7d
JWT_EXPIRES_IN=7d

# --- Seed admin account ---------------------------------------------------
ADMIN_EMAIL=admin@northsupply.test
ADMIN_PASSWORD=admin1234

# --- Mail (Gmail SMTP) ----------------------------------------------------
# Sends from your own Gmail to ANY recipient -- no domain verification needed.
#
# Setup (one time):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#      (name it anything, e.g. "north supply")
#   3. Paste the 16 characters below as SMTP_PASSWORD -- spaces are fine, they
#      are stripped automatically. Your normal Gmail password will NOT work.
#   4. Restart the server, then: npm run mail:test -- someone@example.com
#
# Any other SMTP provider works too -- just change these five values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Gmail requires the sender to be the authenticated account.
MAIL_FROM=NORTH SUPPLY <you@gmail.com>
MAIL_OUTBOX=.mail-outbox

# --- Policy ---------------------------------------------------------------
RETURN_WINDOW_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60

# --- One-time codes -------------------------------------------------------
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Set to false to skip the emailed code on password login (registration always
# requires one).
REQUIRE_LOGIN_OTP=true

# --- Google sign-in -------------------------------------------------------
# Leave blank to disable: the button is hidden and the endpoint refuses.
# Get one at https://console.cloud.google.com/apis/credentials -> OAuth client
# ID -> Web application, with http://localhost:5173 as an authorised origin.
GOOGLE_CLIENT_ID=
